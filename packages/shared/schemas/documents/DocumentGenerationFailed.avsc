{
  "type": "record",
  "name": "DocumentGenerationFailed",
  "namespace": "signingplatform.documents",
  "doc": "Published when the Document Generator cannot produce a draft.",
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "eventType",
      "type": "string"
    },
    {
      "name": "eventVersion",
      "type": "int"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "agreementId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "correlationId",
      "type": "string"
    },
    {
      "name": "reason",
      "type": "string"
    }
  ]
}
