{
  "type": "record",
  "name": "EnvelopeDeclined",
  "namespace": "signingplatform.envelopes",
  "doc": "Published when a signer declines the envelope.",
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "eventType",
      "type": "string"
    },
    {
      "name": "eventVersion",
      "type": "int"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "agreementId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "correlationId",
      "type": "string"
    },
    {
      "name": "envelopeId",
      "type": "string"
    },
    {
      "name": "declinedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "reason",
      "type": [
        "null",
        "string"
      ],
      "default": null
    }
  ]
}
